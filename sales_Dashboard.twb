            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1f0wtsb1753nv913n9jxv1tc6taa'>
            <column aggregation='Sum' caption='CY ' datatype='integer' default-format='n0;-0' name='[Calculation_1174280813658125]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column aggregation='Sum' caption='PY' datatype='integer' default-format='n0;-0' name='[Calculation_1174280813781006]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]-1' />
            </column>
            <column caption='CY Profit' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1174281019113488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1] THEN [Profit]&#13;&#10;END' />
            </column>
            <column caption='PY Profit' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1174281019408401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1]-1 THEN [Profit]&#13;&#10;END' />
            </column>
            <column caption='% Diff profit' datatype='real' name='[Calculation_1174281021423634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1174281019113488])- SUM([Calculation_1174281019408401]))/SUM ([Calculation_1174281019408401])' />
            </column>
            <column caption='mn/mx prft' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1174281051533341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_1174281019113488])= WINDOW_MAX(SUM([Calculation_1174281019113488]))&#13;&#10;THEN SUM([Calculation_1174281019113488])&#13;&#10;ELSEIF SUM([Calculation_1174281019113488])=WINDOW_MIN(SUM([Calculation_1174281019113488]))&#13;&#10;THEN SUM([Calculation_1174281019113488])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
