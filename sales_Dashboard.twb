            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'><![CDATA[<[federated.1f0wtsb1753nv913n9jxv1tc6taa].[sum:Calculation_1174281055526943:qk]> ]]></run>
            <run bold='true' fontcolor='#898989' fontname='Benton Sans Book' fontsize='11'>vs. PY</run>
